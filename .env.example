# JobSetu runtime config. See .env.example for local setup.
SERPAPI_KEY=
DATABASE_URL=sqlite:///./jobsetu.db
ENABLE_NEWS=false
ENABLE_MAPS=false
ENABLE_TRENDS=false
ENABLE_PDF=false
EVIDENCE_MAX_JOBS=5
NEWS_MAX_JOBS=3
# Tracker integration — leave empty for local dev defaults.
# Production:
# TRACKER_API_URL=https://<worker>.<subdomain>.workers.dev
# TRACKER_WEB_ORIGINS=https://<pages>.pages.dev
TRACKER_API_URL=
TRACKER_WEB_ORIGINS=
